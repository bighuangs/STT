# =========================
# 应用基础配置（非敏感；生产必填 APP_ENV/CORS_ORIGINS）
# 兼容期可用原变量名；同名 STT_ 前缀变量优先，例如 STT_APP_ENV。
# =========================
IMPORT_APP_NAME=Enterprise RAG Import Service
QUERY_APP_NAME=Enterprise RAG Query Service
APP_ENV=dev
APP_HOST=0.0.0.0
IMPORT_APP_PORT=8000
QUERY_APP_PORT=8001
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001

# TODO-04 认证与凭据。生产环境必须全部覆盖示例值，服务会拒绝使用开发默认秘密启动。
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
# 仅记录轮换版本/Secret Manager key id，禁止填写 secret value。
AUTH_TOKEN_SECRET_VERSION=env-v1
# 轮换窗口可选：先把旧值放入 PREVIOUS，再切换当前值；所有旧 token/API Key
# 过期或完成轮换后清空。版本字段只填 key id，绝不能填 secret value。
AUTH_PREVIOUS_TOKEN_SECRET=
AUTH_PREVIOUS_TOKEN_SECRET_VERSION=
AUTH_TOKEN_ISSUER=stt
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@stt.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# =========================
# 控制库（敏感：URL 可能包含用户名/密码；生产必填）
# 本地验证默认 SQLite；生产可替换为 PostgreSQL，例如：
# postgresql+psycopg://user:password@127.0.0.1:5432/stt
# =========================
CONTROL_DATABASE_URL=sqlite:///./volumes/control/stt-control.db
MAX_UPLOAD_BYTES=104857600

# TODO-02 独立导入 Worker（Web API 只入队，不执行 LangGraph）
# INGESTION_WORKER_ID 留空时自动使用 hostname-pid-random。
INGESTION_WORKER_ID=
INGESTION_WORKER_POLL_SECONDS=1
INGESTION_LEASE_SECONDS=60
INGESTION_HEARTBEAT_SECONDS=15
INGESTION_MAX_ATTEMPTS=5
INGESTION_RETRY_BASE_SECONDS=2
INGESTION_RETRY_MAX_SECONDS=300
# 单机检查点制品根目录；多主机生产部署必须替换为共享对象存储适配器。
INGESTION_CHECKPOINT_ROOT=./volumes/control/checkpoints

# =========================
# LLM / VL 模型配置
# 注意：
# 1. OPENAI_API_KEY 当前同时被普通 LLM 与 DashScope MCP 配置复用
# 2. LLM_DEFAULT_TEMPERATURE 必须可被转换为 float
# =========================
OPENAI_BASE_URL=https://your-llm-endpoint/v1
OPENAI_API_KEY=sk-your-key
# 敏感值的版本标识，不是密钥。
OPENAI_API_KEY_VERSION=env-v1
LLM_DEFAULT_MODEL=qwen3.7-max
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen-vl-max
# 正数；控制单请求超时、连接池、并发及指数退避。
LLM_REQUEST_TIMEOUT=60
LLM_MAX_CONNECTIONS=20
MAX_CONCURRENT_CHATS=10
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=0.6
LLM_RETRY_MAX_DELAY=8

# =========================
# P3 查询可靠性、事件续传、缓存与内容安全
# Web 结果和回答中的外链都采用显式域名白名单；空值表示 fail-closed。
# =========================
# 全链路 QueryRun deadline；内建本地检索 profile 为 90000ms，预留重排与生成窗口。
QUERY_DEFAULT_DEADLINE_MS=120000
QUERY_RECOVERY_INTERVAL_SECONDS=5
# 可靠 Query checkpoint 专用 AES-256-GCM key：URL-safe base64 编码的 32 bytes。
# 不得复用或派生自 AUTH/JWT/数据库凭据；缺失时可靠 Query 在创建运行前 fail-closed。
QUERY_CHECKPOINT_ENCRYPTION_KEY=
QUERY_EVENT_RETENTION_SECONDS=604800
QUERY_EVENT_BATCH_SIZE=100
QUERY_STREAM_MAX_LAG_EVENTS=1000
QUERY_STREAM_MAX_BATCH_BYTES=1048576
QUERY_CACHE_TTL_SECONDS=300
QUERY_IDEMPOTENCY_TTL_SECONDS=86400
QUERY_SINGLEFLIGHT_LEASE_SECONDS=30
QUERY_REPLAY_RETENTION_DAYS=30
QUERY_WEB_ALLOWED_DOMAINS=
QUERY_OUTPUT_LINK_ALLOWED_DOMAINS=

# =========================
# Embedding 配置
# =========================
BGE_M3_PATH=./models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False

# =========================
# Reranker 配置
# =========================
BGE_RERANKER_LARGE=./models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False
# 重排安全上限：每批仅保留少量 pair，query + document + 8 个特殊 token <= 512。
BGE_RERANKER_BATCH_SIZE=2
BGE_RERANKER_MAX_INPUT_TOKENS=512
BGE_RERANKER_QUERY_MAX_TOKENS=128
BGE_RERANKER_DOCUMENT_MAX_TOKENS=376
# preserve_order 在模型 OOM/异常时保留融合顺序；error 返回 RERANKER_UNAVAILABLE。
BGE_RERANKER_FAILURE_MODE=preserve_order
# 仅在首次加载模型前检查；0 可关闭对应检查。CPU 上的 bge-reranker-large/v2-m3
# 初始化会短时占用数 GiB 内存，低于默认值时先安全降级，避免 native loader 终止进程。
BGE_RERANKER_MIN_AVAILABLE_PHYSICAL_MIB=1536
BGE_RERANKER_MIN_AVAILABLE_COMMIT_MIB=4096

# =========================
# Milvus 配置
# =========================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entities
ITEM_NAME_COLLECTION=kb_item_names
# 物理位置只由服务端策略决定，前端/API 不得传 collection/partition 名。
VECTOR_PLACEMENT_MODE=shared_compatible
VECTOR_PLACEMENT_POLICY_VERSION=placement.v1

# =========================
# Mongo 配置
# =========================
# 敏感：允许包含 Mongo 用户名/密码，健康接口只显示删除 userinfo 后的地址。
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=enterprise_rag
MONGO_SECRET_VERSION=env-v1

# =========================
# MinIO 配置
# endpoint 不带 http/https，由代码内部配合 secure 使用
# MINIO_IMG_DIR 建议以 / 开头，例如 /kb-images
# =========================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_CREDENTIAL_VERSION=env-v1
MINIO_BUCKET_NAME=enterprise-rag
MINIO_IMG_DIR=/kb-images
MINIO_SECURE=False

# =========================
# MinerU 配置
# =========================
MINERU_BASE_URL=https://your-mineru-endpoint
MINERU_API_TOKEN=your-mineru-token
MINERU_TOKEN_VERSION=env-v1

# =========================
# DashScope MCP / WebSearch 配置
# 当前 node_web_search_mcp 固定走 DashScope WebSearch MCP
# MCP_DASHSCOPE_BASE_URL 当前代码未实际使用，但建议仍保留
# =========================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# =========================
# TODO-05 健康探针与启动门禁（非敏感）
# live 不访问外部依赖；ready 并发执行以下依赖探测并按 TTL 缓存。
# STARTUP_REQUIRE_READY=true 时，任一当前角色 required dependency 失败会拒绝启动。
# production 环境无论该开关为何值，都会启用启动依赖门禁。
# =========================
HEALTH_PROBE_TIMEOUT_SECONDS=2
HEALTH_CACHE_TTL_SECONDS=5
STARTUP_REQUIRE_READY=False
IMPORT_REQUIRED_DEPENDENCIES=control_database,queue,milvus,minio
QUERY_REQUIRED_DEPENDENCIES=control_database,milvus,mongo,llm
WORKER_REQUIRED_DEPENDENCIES=control_database,queue,milvus,minio

# =========================
# 日志（非敏感）
# 日志管线自动过滤 Authorization/API Key/password/token 和已知秘密；
# 文件 sink 禁用 diagnose/backtrace 局部变量展开。
# =========================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# =========================
# Phoenix / OpenTelemetry（可选，默认关闭）
# 启用后只导出已脱敏的 Trace；API key 属于敏感值，不得提交到版本控制。
# HTTP endpoint 可填写 Phoenix base URL，应用会自动补全 /v1/traces。
# =========================
PHOENIX_ENABLED=False
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=stt
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_BATCH=True
PHOENIX_AUTO_INSTRUMENT=True
PHOENIX_API_KEY=

# =========================
# 项目根目录可选配置
# 如果未设置，代码会自动递归查找 .env
# =========================
PROJECT_ROOT=
